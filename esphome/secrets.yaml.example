# Copia questo file come secrets.yaml nella cartella ESPHome e sostituisci i valori.
wifi_ssid: "NOME_RETE_WIFI"
wifi_password: "PASSWORD_WIFI"

# Solo per esphome/zonergy-venus-esp32-ble.yaml.
# Usa l'indirizzo BLE rilevato dall'ESP32 e il PIN richiesto dall'app Zonergy,
# normalmente riportato sul dongle Wi-Fi originale.
zonergy_ble_mac: "AA:BB:CC:DD:EE:FF"
zonergy_ble_pin: "PIN_DONGLE"

# Facoltativo: genera una chiave base64 a 32 byte e abilita encryption nel YAML.
# api_encryption_key: "INSERISCI_LA_CHIAVE_GENERATA_DA_ESPHOME"
